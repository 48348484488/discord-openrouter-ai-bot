{
  "name": "discord-openrouter-ai-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Discord Interactions bot using Cloudflare Workers and OpenRouter.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "wrangler check",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "register": "tsx scripts/register-commands.ts register",
    "unregister": "tsx scripts/register-commands.ts unregister"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260730.0",
    "@types/node": "^24.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "wrangler": "^4.29.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
